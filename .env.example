# EventSphere Configuration
PROJECT_NAME="EventSphere"
ENVIRONMENT="development"
SECRET_KEY="eventsphere-ultra-secure-random-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for dev, PostgreSQL for production/Render)
DATABASE_URL="sqlite:///./eventsphere.db"
# Example PostgreSQL for Render / Supabase:
# DATABASE_URL="postgresql://user:password@hostname:5432/eventsphere"

# Agent Timing Configurations (in seconds)
CART_HOLD_DURATION_SECONDS=300
WAITLIST_HOLD_DURATION_SECONDS=300
WAITLIST_SWEEP_INTERVAL_SECONDS=15
VENUE_TURNAROUND_BUFFER_MINUTES=60

# Port & Host
PORT=8000
HOST="0.0.0.0"
